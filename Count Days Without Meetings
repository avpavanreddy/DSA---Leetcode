class Solution {
public:
    int countDays(int days, vector<vector<int>>& meetings) {
        int m=meetings.size();
        int n=meetings[0].size();
        vector<vector<int>>intervals(meetings);
    
        sort(intervals.begin(),intervals.end(),[](const vector<int>&a,const vector<int>&b){
            return a[0]<b[0];
        });
        int cnt=0;
        int currentDayStart=intervals[0][0];
        int currentDayEnd=intervals[0][1];
        for(int i=1;i<m;i++)
        {
            int nextDayStart=intervals[i][0];
            int nextDayEnd=intervals[i][1];
            // in case of overlap
            if(nextDayStart <= currentDayEnd)
            {
                currentDayEnd=max(currentDayEnd,nextDayEnd);
            }
            else{
                 cnt+=(currentDayEnd-currentDayStart+1);
                 currentDayStart=nextDayStart;
                 currentDayEnd=nextDayEnd;
            }
        }
        cnt+=(currentDayEnd-currentDayStart+1);
        return days-cnt;
    }
};
