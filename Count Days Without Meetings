class Solution {
    public int countDays(int days, int[][] meetings) {
        int m=meetings.length;
        int n=meetings[0].length;
        Set<Integer> s = new HashSet<>();
        for(int i=0;i<m;i++)
        {
            int start=meetings[i][0];
            int end=meetings[i][1];
            for(int j=start;j<=end;j++)
            s.add(j);
        }
        return days-s.size();
    }
}
